# ===========================================
#  .gitignore — Portfólio (React + Vite)
#  Evita subir dependências, build e dados sensíveis para o GitHub.
# ===========================================

# Dependências
node_modules/
.pnp
.pnp.js

# Build / saída de produção
dist/
dist-ssr/
build/

# Variáveis de ambiente e segredos (NUNCA versionar)
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
credentials.json

# Arquivos locais
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Cache de ferramentas
.cache/
.vite/
.eslintcache

# Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini
